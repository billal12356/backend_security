# Application Environment
NODE_ENV=development
PORT=3000

# Security & Session
SESSION_SECRET=change_this_to_a_secure_random_secret_in_production
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database Connection (Local / Outside Docker: port 5433, Inside Docker Compose: postgres:5432)
# Local development against Docker Postgres:
DATABASE_URL=postgresql://postgres:billal123@localhost:5433/backend_secure

# Docker Compose Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=billal123
POSTGRES_DB=backend_secure
POSTGRES_PORT=5433
